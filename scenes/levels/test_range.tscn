[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/levels/level.gd" id="1_level"]
[ext_resource type="Resource" path="res://resources/levels/test_range.tres" id="2_layout"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="3_player"]
[ext_resource type="Script" path="res://scripts/camera/game_camera.gd" id="4_camera"]
[ext_resource type="PackedScene" path="res://scenes/ui/hud.tscn" id="5_hud"]

[node name="TestRange" type="Node2D"]
script = ExtResource("1_level")
layout = ExtResource("2_layout")
player_scene = ExtResource("3_player")
